        "趋势",
        "均线",
        "只做多",
        "合约",
        "BTC"
      ],
      "icon": "📈",
      "params": {
        "fast_window": {
          "label": "快线周期",
          "widget": "number",
          "min": 2,
          "max": 100,
          "step": 1
        },
        "slow_window": {
          "label": "慢线周期",
          "widget": "number",
          "min": 5,
          "max": 400,
          "step": 1
        },
        "entry_threshold": {
          "label": "价差阈值",
