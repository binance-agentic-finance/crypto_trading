{
  "strategy": "square_buzz_screener",

  "modes": {
    "default": {
      "description": "Attention-driven screener, verdict gates trade",
      "leverage_range": [1, 3],
      "stop_pct": 5.0,
      "risk_pct": 2.0
    }
  },

  "universe": {
    "locales": ["en", "zh-CN"],
    "sections": ["most_searched", "rapid_riser"],
    "hashtag_deep_fetch": true,
    "max_candidates": 15
  },

  "signals": {
    "ema":  { "fast": 20, "mid": 60, "slow": 200 },
    "rsi":  { "period": 14, "overbought": 70, "oversold": 30 },
    "macd": { "fast": 12, "slow": 26, "signal": 9 },
    "atr":  { "period": 14 },
    "volume": { "surge_multiplier": 2.0, "lookback": 24 },
    "timeframes": {
      "primary": "4h",
      "confirmation": ["1h", "1d"]
    }
  },

  "scoring": {
    "tiers": {
      "attention_frequency": { "en_cn_overlap": 3, "section_overlap": 2, "single_source": 1, "isolated": 0 },
      "attention_deep":      { "positive_sentiment": 2, "mixed": 1, "negative": -1 },
      "ema_trend":           { "all_aligned": 3, "two_aligned": 2, "one_aligned": 1, "none": -2 },
      "rsi_zone":            { "favorable": 2, "neutral": 1, "extreme": -1 },
      "macd_momentum":       { "strong": 2, "positive": 1, "negative": -1, "divergent": -2 },
      "derivatives":         { "funding_squeeze": 2, "oi_building": 1, "crowded": -2, "neutral": 0 },
      "volatility":          { "expanding": 1, "contracting": 0, "extreme": -1 },
      "resonance":           { "all_aligned": 2, "partial": 1, "conflicting": -1 },
      "volume":              { "surge": 2, "elevated": 1, "flat": 0 }
    },
    "verdict_thresholds": {
      "STRONG_CANDIDATE": 12,
      "CANDIDATE":         7,
      "WATCHLIST":         3,
      "AVOID_below":       0
    }
  },

  "trade": {
    "account_balance_usdt": 1000
  },

  "execution": {
    "enabled": false,
    "live":    false,
    "mode":    "futures",
    "profile": "default",
    "min_verdict": "STRONG_CANDIDATE",
    "max_concurrent_positions": 3,
    "max_price_deviation_pct":  2.0
  }
}
